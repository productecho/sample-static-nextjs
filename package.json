{
  "name": "nextjs-static",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js static export (SSG) sample — HTML files, no Node.js server at request time",
  "scripts": {
    "dev": "npx next dev",
    "build": "NODE_ENV=production npx next build",
    "start": "npx serve out -s -l tcp://0.0.0.0:${PORT:-3000}",
    "preview": "npx serve out -s -l tcp://0.0.0.0:${PORT:-3000}"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
